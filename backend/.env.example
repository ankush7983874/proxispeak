# Backend environment variables — copy this to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# Frontend origin (for CORS and Socket.IO)
FRONTEND_URL=http://localhost:5173

# MongoDB connection string
# Local:  mongodb://localhost:27017/proxispeak
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/proxispeak
MONGODB_URI=mongodb://localhost:27017/proxispeak

# STUN servers (comma-separated URLs, Google's public STUN is fine for development)
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN server (optional — needed only if clients are behind symmetric NATs or restrictive firewalls)
# Example: turn:turn.example.com:3478
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Rate limiting — max move events per second per socket
MOVE_RATE_LIMIT=20
